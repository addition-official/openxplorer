<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: AGPL-3.0-only -->
<!--
  The browsing window's frame: the static layout of v2.0.0:desktop/ui/index.html,
  top to bottom. src/window/mod.rs binds the parts it updates by id. On
  the Settings tab the Settings page takes the place of the navigation
  row, the command bar, the workspace and the status bar
  (src/window/settings_tab.rs). The status bar follows the settings
  mockup, which has none; `.settings-open` in style.css kept it.

  Buttons name no action here: Rust sets every action name from
  WindowAction, so a misspelt name is a compile error, and draws the
  glyphs, which src/icons paints natively.
-->
<interface>
  <requires lib="gtk" version="4.14"/>
  <template class="OxBrowserWindow" parent="GtkApplicationWindow">
    <property name="title" translatable="yes">OpenXplorer</property>
    <!-- set_default_size(1320, 810) in v2.0.0:desktop/winspace.py. -->
    <property name="default-width">1320</property>
    <property name="default-height">810</property>
    <!-- set_size_request(670, 470) in v2.0.0:desktop/winspace.py. -->
    <property name="width-request">670</property>
    <property name="height-request">470</property>
    <style>
      <class name="ox"/>
    </style>
    <!--
      header.titlebar: caption buttons, the tabs, "+" right after the last
      tab, the drag area taking the rest and the caption buttons. Windows
      11 has no open-windows button there, so neither has this bar: the
      tab menu, Settings and the launcher open that list from the tab in
      front (src/window/tab_menu.rs). The whole bar is a GtkWindowHandle, so dragging or
      double-clicking any empty part moves or maximises the window as the
      desktop expects; the tabs' drag source on the handle claims a dragged
      tab first, so a tab drag never moves the window.
    -->
    <property name="titlebar">
      <object class="GtkWindowHandle">
        <property name="child">
          <object class="GtkBox">
            <style>
              <class name="ox-titlebar"/>
            </style>
            <child>
              <object class="OxCaptionButtons">
                <property name="side">start</property>
              </object>
            </child>
            <child>
              <object class="OxTabStrip" id="tab_strip"/>
            </child>
            <child>
              <object class="GtkButton" id="new_tab_button">
                <property name="tooltip-text" translatable="yes">New tab (Ctrl+T)</property>
                <property name="valign">end</property>
                <style>
                  <class name="newtab"/>
                </style>
                <accessibility>
                  <property name="label" translatable="yes">New tab</property>
                </accessibility>
              </object>
            </child>
            <child>
              <!-- .title-drag: the empty part of the bar, which keeps its
                   CSS minimum width so the window can always be grabbed. -->
              <object class="GtkBox" id="title_drag">
                <property name="hexpand">true</property>
                <style>
                  <class name="title-drag"/>
                </style>
              </object>
            </child>
            <child>
              <object class="OxCaptionButtons">
                <property name="side">end</property>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
    <property name="child">
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <child>
          <!-- section.navigation: the history buttons, the address and the
               search box, 14 pixels apart by their CSS border-spacing,
               which narrow windows shrink. -->
          <object class="GtkBox" id="navigation_row">
            <style>
              <class name="navigation"/>
            </style>
            <accessibility>
              <property name="label" translatable="yes">Navigation</property>
            </accessibility>
            <child>
              <!-- .nav-buttons: Back, Forward, Up and Refresh, added from
                   the table in navigation_buttons.rs. -->
              <object class="GtkBox" id="navigation_buttons">
                <property name="valign">center</property>
                <style>
                  <class name="nav-buttons"/>
                </style>
              </object>
            </child>
            <child>
              <object class="OxAddressBar" id="address_bar"/>
            </child>
            <child>
              <object class="OxSearchBox" id="search_box"/>
            </child>
          </object>
        </child>
        <child>
          <object class="OxCommandBar" id="command_bar"/>
        </child>
        <child>
          <!-- The toast lies over the workspace or the Settings page, at
               its bottom centre. -->
          <object class="GtkOverlay">
            <property name="vexpand">true</property>
            <property name="child">
              <!-- Only the surface shown counts towards the window's size. -->
              <object class="GtkStack" id="surfaces">
                <property name="hhomogeneous">false</property>
                <property name="vhomogeneous">false</property>
                <child>
                  <object class="GtkStackPage">
                    <property name="name">browsing</property>
                    <property name="child">
                      <!-- The sidebar and the panes beside it, split by the 6-pixel
                           .sidebar-resizer. -->
                      <object class="GtkPaned" id="workspace">
                        <property name="orientation">horizontal</property>
                        <property name="vexpand">true</property>
                        <property name="wide-handle">true</property>
                        <property name="shrink-start-child">false</property>
                        <property name="shrink-end-child">false</property>
                        <property name="resize-start-child">false</property>
                        <style>
                          <class name="workspace"/>
                        </style>
                        <property name="start-child">
                          <object class="OxSidebar" id="sidebar"/>
                        </property>
                        <property name="end-child">
                          <object class="GtkBox">
                            <child>
                              <!-- The resizer as keyboard and screen readers
                                   meet it (role=separator in index.html):
                                   no width of its own, it sits in the Tab
                                   order between the sidebar and the files
                                   and lights the pane handle when focused. -->
                              <object class="OxResizerControl" id="sidebar_resizer">
                                <property name="focusable">true</property>
                              </object>
                            </child>
                            <child>
                              <!-- The search strip sits above the columns
                                   (#search-info in index.html). -->
                              <object class="GtkBox">
                                <property name="orientation">vertical</property>
                                <property name="hexpand">true</property>
                                <child>
                                  <object class="OxSearchInfoStrip" id="search_strip"/>
                                </child>
                                <child>
                                  <!-- The folder pane, and a second one
                                       beside it while the tab is split
                                       (VIEW-059, split_view.rs). -->
                                  <object class="GtkPaned" id="pane_split">
                                    <style>
                                      <class name="pane-split"/>
                                    </style>
                                    <property name="shrink-start-child">false</property>
                                    <property name="shrink-end-child">false</property>
                                    <property name="start-child">
                                      <object class="GtkBox" id="start_pane_column">
                                        <property name="orientation">vertical</property>
                                        <child>
                                          <object class="GtkLabel" id="start_pane_caption">
                                            <property name="visible">false</property>
                                            <property name="xalign">0</property>
                                            <property name="ellipsize">middle</property>
                                            <style>
                                              <class name="pane-caption"/>
                                            </style>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="OxFolderPane" id="folder_pane">
                                            <style>
                                              <class name="folder-pane-host"/>
                                            </style>
                                          </object>
                                        </child>
                                      </object>
                                    </property>
                                    <property name="end-child">
                                      <object class="GtkBox" id="end_pane_column">
                                        <property name="orientation">vertical</property>
                                        <property name="visible">false</property>
                                        <child>
                                          <object class="GtkLabel" id="end_pane_caption">
                                            <property name="xalign">0</property>
                                            <property name="ellipsize">middle</property>
                                            <style>
                                              <class name="pane-caption"/>
                                            </style>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="OxFolderPane" id="split_pane">
                                            <style>
                                              <class name="folder-pane-host"/>
                                            </style>
                                          </object>
                                        </child>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="OxDetailsPane" id="details_pane"/>
                            </child>
                          </object>
                        </property>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="GtkStackPage">
                    <property name="name">settings</property>
                    <property name="child">
                      <object class="OxSettingsPage" id="settings_page"/>
                    </property>
                  </object>
                </child>
              </object>
            </property>
            <child type="overlay">
              <object class="OxToast" id="toast"/>
            </child>
            <child type="overlay">
              <!-- The update notice lies at the top right, under the
                   command bar. -->
              <object class="OxUpdateNotice" id="update_notice"/>
            </child>
          </object>
        </child>
        <child>
          <object class="OxStatusBar" id="status_bar"/>
        </child>
        <child>
          <object class="GtkBox" id="picker_bar">
            <property name="visible">False</property>
            <property name="spacing">24</property>
            <style>
              <class name="picker-bar"/>
            </style>
          </object>
        </child>
      </object>
    </property>
  </template>
</interface>
