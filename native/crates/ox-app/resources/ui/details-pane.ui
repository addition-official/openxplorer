<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: AGPL-3.0-only -->
<!--
  The details pane, laid out as Windows 11 File Explorer's and section 4.8
  of native/docs/ui-spec.md: a header with a close button, the picture
  without a frame, the name, the folder's item count and the rows of names
  and values (src/window/details_pane.rs). It has no buttons.

  Every text wraps with a natural width of a few words (max-width-chars
  10), so a long name or path wraps inside the pane instead of widening it.
-->
<interface>
  <requires lib="gtk" version="4.14"/>
  <template class="OxDetailsPane" parent="GtkWidget">
    <!-- A fixed width: the property values expand within the pane, and
         without it the pane would take half the window from the list. -->
    <property name="hexpand">false</property>
    <style>
      <class name="details"/>
    </style>
    <child>
      <!-- The pane scrolls when the window is too short for it
           (.details{overflow:auto}), so its wrapped properties never set
           the window's height. -->
      <object class="GtkScrolledWindow" id="scroller">
        <property name="hscrollbar-policy">never</property>
        <property name="child">
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <style>
              <class name="details-inner"/>
            </style>
            <child>
              <object class="GtkBox">
                <style>
                  <class name="detail-header"/>
                </style>
                <child>
                  <object class="GtkLabel" id="i18n_1">
                    <property name="label" translatable="yes">Details</property>
                    <property name="xalign">0</property>
                    <property name="hexpand">true</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="close_button">
                    <property name="tooltip-text" translatable="yes">Close details pane</property>
                    <accessibility>
                      <property name="label" translatable="yes">Close details pane</property>
                    </accessibility>
                    <style>
                      <class name="detail-close"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkCenterBox" id="preview_area">
                <style>
                  <class name="detail-preview"/>
                </style>
                <property name="center-widget">
                  <!-- The item's or folder's art (an ArtImage,
                       src/icons/art_image.rs); several items' art is
                       stacked in its place. -->
                  <object class="OxArtImage" id="preview"/>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="name">
                <property name="xalign">0</property>
                <property name="wrap">true</property>
                <property name="wrap-mode">word-char</property>
                <property name="max-width-chars">10</property>
                <property name="selectable">true</property>
                <!-- Selectable with the pointer but no Tab stop (see
                     property_value in details_pane.rs). -->
                <property name="focusable">false</property>
                <property name="can-focus">false</property>
                <style>
                  <class name="detail-name"/>
                </style>
              </object>
            </child>
            <child>
              <!-- "12 items" under the folder's name. -->
              <object class="GtkLabel" id="summary">
                <property name="xalign">0</property>
                <property name="wrap">true</property>
                <property name="wrap-mode">word-char</property>
                <property name="max-width-chars">10</property>
                <style>
                  <class name="detail-summary"/>
                </style>
              </object>
            </child>
            <child>
              <!-- The rows are 12 pixels apart, a name 8 pixels from its
                   value. -->
              <object class="GtkGrid" id="properties">
                <property name="row-spacing">12</property>
                <property name="column-spacing">8</property>
              </object>
            </child>
          </object>
        </property>
      </object>
    </child>
  </template>
</interface>
