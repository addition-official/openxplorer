<!--
  The details pane (aside.details; renderDetails in v2.0.0:desktop/ui/app.js),
  laid out as section 4.8 of native/docs/ui-spec.md: a header with a close
  button, the preview, the name and type, the Open and "Pin to Quick
  access" buttons, the Properties grid and a note
  (src/window/details_pane/mod.rs).

  Every text wraps with a natural width of a few words (max-width-chars
  10), so a long name or path wraps inside the pane instead of widening it.
-->
<interface>
  <requires lib="gtk" version="4.14"/>
  <template class="OxDetailsPane" parent="GtkWidget">
    <!-- A fixed width: the property values expand within the pane, and
         without it the pane would take half the window from the list. -->
    <property name="hexpand">false</property>
    <style>
      <class name="details"/>
    </style>
    <child>
      <!-- The pane scrolls when the window is too short for it
           (.details{overflow:auto}), so its wrapped properties never set
           the window's height. -->
      <object class="GtkScrolledWindow" id="scroller">
        <property name="hscrollbar-policy">never</property>
        <property name="child">
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <style>
              <class name="details-inner"/>
            </style>
            <child>
              <object class="GtkBox">
                <style>
                  <class name="detail-header"/>
                </style>
                <child>
                  <object class="GtkLabel" id="i18n_1">
                    <property name="label" translatable="yes">Details</property>
                    <property name="xalign">0</property>
                    <property name="hexpand">true</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="close_button">
                    <property name="tooltip-text" translatable="yes">Close details pane</property>
                    <accessibility>
                      <property name="label" translatable="yes">Close details pane</property>
                    </accessibility>
                    <style>
                      <class name="detail-close"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkCenterBox" id="preview_area">
                <style>
                  <class name="detail-preview"/>
                </style>
                <property name="center-widget">
                  <!-- The item's art, or the copy glyph for several items
                       (an ArtImage, src/icons/art_image.rs). -->
                  <object class="OxArtImage" id="preview"/>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="name">
                <property name="xalign">0</property>
                <property name="wrap">true</property>
                <property name="wrap-mode">word-char</property>
                <property name="max-width-chars">10</property>
                <property name="selectable">true</property>
                <style>
                  <class name="detail-name"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="kind">
                <property name="xalign">0</property>
                <property name="wrap">true</property>
                <property name="wrap-mode">word-char</property>
                <property name="max-width-chars">10</property>
                <style>
                  <class name="detail-type"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="open_button">
                <style>
                  <class name="detail-button"/>
                  <class name="bordered"/>
                </style>
                <property name="child">
                  <object class="GtkBox">
                    <property name="spacing">8</property>
                    <property name="halign">center</property>
                    <child>
                      <object class="GtkImage" id="open_glyph">
                        <property name="halign">center</property>
                        <property name="valign">center</property>
                        <property name="accessible-role">presentation</property>
                        <style>
                          <class name="glyph"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="i18n_2">
                        <property name="label" translatable="yes">Open</property>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <!-- Pins the one selected folder. -->
              <object class="GtkButton" id="pin_item_button">
                <style>
                  <class name="detail-button"/>
                  <class name="bordered"/>
                </style>
                <property name="child">
                  <object class="GtkBox">
                    <property name="spacing">8</property>
                    <property name="halign">center</property>
                    <child>
                      <object class="GtkImage" id="pin_item_glyph">
                        <property name="halign">center</property>
                        <property name="valign">center</property>
                        <property name="accessible-role">presentation</property>
                        <style>
                          <class name="glyph"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="i18n_3">
                        <property name="label" translatable="yes">Pin to Quick access</property>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <!-- Pins the folder the tab shows, when nothing is selected. -->
              <object class="GtkButton" id="pin_folder_button">
                <style>
                  <class name="detail-button"/>
                  <class name="bordered"/>
                </style>
                <property name="child">
                  <object class="GtkBox">
                    <property name="spacing">8</property>
                    <property name="halign">center</property>
                    <child>
                      <object class="GtkImage" id="pin_folder_glyph">
                        <property name="halign">center</property>
                        <property name="valign">center</property>
                        <property name="accessible-role">presentation</property>
                        <style>
                          <class name="glyph"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="i18n_4">
                        <property name="label" translatable="yes">Pin to Quick access</property>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="i18n_5">
                <property name="label" translatable="yes">Properties</property>
                <property name="xalign">0</property>
                <property name="wrap">true</property>
                <property name="wrap-mode">word-char</property>
                <property name="max-width-chars">10</property>
                <style>
                  <class name="detail-section"/>
                </style>
              </object>
            </child>
            <child>
              <!-- .detail-props{gap:15px 8px}: the rows are 15 pixels
                   apart, a name 8 pixels from its value. -->
              <object class="GtkGrid" id="properties">
                <property name="row-spacing">15</property>
                <property name="column-spacing">8</property>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <property name="spacing">5</property>
                <style>
                  <class name="detail-note"/>
                </style>
                <child>
                  <object class="GtkImage" id="note_glyph">
                    <property name="halign">center</property>
                    <property name="valign">center</property>
                    <property name="accessible-role">presentation</property>
                    <style>
                      <class name="glyph"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="note">
                    <!-- The narrow natural width keeps the pane from growing;
                         hexpand then lets the note fill the pane's width. -->
                    <property name="hexpand">true</property>
                    <property name="xalign">0</property>
                    <property name="wrap">true</property>
                    <property name="wrap-mode">word-char</property>
                    <property name="max-width-chars">10</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </child>
  </template>
</interface>
