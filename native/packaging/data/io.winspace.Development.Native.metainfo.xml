<!--
  The AppStream description of the native preview, which runs beside the
  Python app under its own ID until it replaces it. Its releases are marked
  "development", so software centres never present it as the stable app.
-->
<component type="desktop-application">
  <id>io.winspace.Development.Native</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-only</project_license>
  <name>OpenXplorer Native Preview</name>
  <summary>Preview of the native OpenXplorer file manager</summary>
  <developer id="app.openxplorer">
    <name>OpenXplorer contributors</name>
  </developer>
  <description>
    <p>A preview of the next OpenXplorer, drawn with native GTK 4 widgets instead of a web page. It browses local folders, SMB shares and connected phones in the familiar tabbed window styled after Windows 11 File Explorer.</p>
    <p>The preview is incomplete and runs beside the current OpenXplorer without replacing it. It never changes file associations, browser preferences or network mounts.</p>
  </description>
  <launchable type="desktop-id">io.winspace.Development.Native.desktop</launchable>
  <icon type="stock">io.winspace.Development.Native</icon>
  <provides>
    <binary>openxplorer-native</binary>
  </provides>
  <categories>
    <category>System</category>
    <category>FileManager</category>
  </categories>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>
  <branding>
    <color type="primary" scheme_preference="light">#fcd53f</color>
    <color type="primary" scheme_preference="dark">#7a5c00</color>
  </branding>
  <!--
    OARS social-info is mild: the update check contacts GitHub's API for
    the latest release, which OARS defines as "checking for the latest
    application version". No other attribute applies: no violence, drugs,
    sex, language, social chat, in-app purchases or advertising.
  -->
  <content_rating type="oars-1.1">
    <content_attribute id="social-info">mild</content_attribute>
  </content_rating>
  <!--
    TODO(Flathub): add <screenshots> of the native app. Flathub requires at
    least one, served over HTTPS from a stable URL such as
    https://openxplorer.app/assets/screenshots/. The public screenshots in
    apps/web/public/assets/screenshots/ show the 1.x web interface with a
    "1.1.4 preview" label, so they do not describe this app; capture new ones
    of the native window on fictional files (OPENXPLORER_SNAPSHOT, see
    docs/PRIVACY.md) and publish them first. native/packaging/README.md,
    "Publishing on Flathub", lists the remaining steps.
  -->
  <releases>
    <release version="2.0.1" date="2026-10-02" type="development"><description><p>Preview build of OpenXplorer 2.0.1 under its own application ID.</p></description></release>
    <release version="2.0.0" date="2026-09-28" type="development"><description><p>Preview build of OpenXplorer 2.0.0 under its own application ID.</p></description></release>
    <release version="0.1.0" date="2026-09-28" type="development"><description><p>First packaged native preview of the GTK 4 interface, for trying it beside the current OpenXplorer.</p></description></release>
  </releases>
  <url type="homepage">https://openxplorer.app</url>
  <url type="help">https://openxplorer.app/docs/installation/</url>
  <url type="vcs-browser">https://github.com/AKolenda/openxplorer</url>
  <url type="bugtracker">https://github.com/AKolenda/openxplorer/issues</url>
  <keywords>
    <keyword>File Explorer</keyword>
    <keyword>File Manager</keyword>
    <keyword>files</keyword>
    <keyword>folders</keyword>
    <keyword>SMB</keyword>
    <keyword>NAS</keyword>
    <keyword>network</keyword>
    <keyword>ZIP</keyword>
  </keywords>
</component>
